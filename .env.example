# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — server-only, bypasses RLS.
# Used by the Stripe webhook & checkout to write orders. NEVER expose to the client.
# Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test mode to start)
STRIPE_SECRET_KEY=sk_test_...
# From the Stripe webhook endpoint's signing secret (Developers → Webhooks),
# or from `stripe listen` when testing locally.
STRIPE_WEBHOOK_SECRET=whsec_...
